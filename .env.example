ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mcp_ops
POSTGRES_USER=mcp_ops
POSTGRES_PASSWORD=change-me-local-only

REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OPENSEARCH_URL=http://opensearch:9200

JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=mcp-engineering-ops
JWT_SECRET_KEY=change-me-local-only

SERVICE_AUTH_SHARED_SECRET=change-me-local-only
APPROVAL_TTL_SECONDS=3600

LLM_PROVIDER=deterministic
LLM_PLANNER_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20

EMBEDDING_PROVIDER=hashing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=20
OPENSEARCH_TOOL_INDEX=mcp-tools
OPENSEARCH_KNOWLEDGE_INDEX=engineering-knowledge
TOOL_DISCOVERY_INDEX_BACKEND=memory
KNOWLEDGE_INDEX_BACKEND=memory
RAG_INCLUDE_REPOSITORY_DOCS=true

GITHUB_TOKEN=replace-with-your-github-token
GITHUB_OWNER=ImmanuelP31
GITHUB_REPO=MCP_AI
GITHUB_DEFAULT_BRANCH=main
GITHUB_ALLOWED_REPOSITORIES=ImmanuelP31/MCP_AI
GITHUB_API_BASE_URL=https://api.github.com
